{
  // Allow anyone to read data, but only authenticated content owners can
  // make changes to their data
  "rules": {
    ".read": true,
    ".write": false,
    "database": {
      "users": {
        "$uid": {
          ".read": true,
          ".write": "auth.uid === $uid"
        }
      },
      "spaceInvaders": {
        "$uid": {
          ".read": true,
          ".write": "auth.uid === $uid"
        }
      },
      "geoDash": {
        "$uid": {
          ".read": true,
          ".write": "auth.uid === $uid"
        }
      }
    }
  }
}